# Copie para .env e preencha. O .env esta no .gitignore.

# GCP — projeto que fatura as consultas ao BigQuery.
# A Base dos Dados e publica, mas quem executa paga pela varredura.
GCP_PROJECT_ID=

# Autenticacao: use Application Default Credentials, sem arquivo de chave.
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project SEU_PROJETO

# AWS — origem das camadas Silver e Gold construidas na Fase 2
AWS_REGION=us-east-1
AWS_BUCKET=

# dev | prod
PIPELINE_ENV=dev
